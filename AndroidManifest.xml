<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="os.vanks.launcher"
    android:versionCode="27"
    android:versionName="0.27">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- пункт управления: Wi‑Fi/Bluetooth (только узнать, включены ли), «Не беспокоить»,
         яркость и автоповорот (Android попросит разрешение отдельно) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- обновление по воздуху: релизы на GitHub и установка новой версии -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- «Недавние»: закрыть приложение карточкой вверх -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- боковая панель поверх приложений: окно поверх, служба с уведомлением -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- свой экран блокировки: палец без системного окна, снова после перезагрузки -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- те же обои и в системе -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- жесты вместо кнопок на HyperOS: выдаётся только с компьютера (adb shell pm grant) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- только в Vanks OS (системное приложение, rom/a04): «Обвести и найти»,
         обновления без подтверждения, все задачи для «Недавних». На обычном
         телефоне Android их просто не выдаёт. -->
    <!-- камера Vanks -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- звук в роликах камеры Vanks -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_CONTEXTUAL_SEARCH" />
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <!-- Vanks OS: экран блокировки и AOD из фона без «Поверх других приложений» -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <!-- Vanks OS: системная шторка не раскрывается, сверху — панель Vanks -->
    <uses-permission android:name="android.permission.STATUS_BAR" />
    <!-- Vanks OS: плитка «Экономия заряда» включает режим сама -->
    <uses-permission android:name="android.permission.POWER_SAVER" />
    <!-- Vanks OS: язык системы в мастере первого запуска -->
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <!-- шторка: имя и значок любого приложения, приславшего уведомление -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- видеть все приложения, у которых есть значок -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- паки значков (ADW / Nova / GO) -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" /></intent>
        <!-- «Найти паки значков» -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- зажатие полоски внизу: поиск Google и Google Lens -->
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.google.ar.lens" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Vanks"
        android:allowBackup="true"
        android:largeHeap="true"
        android:supportsRtl="false">
        <activity
            android:name=".Home"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Vanks OS: мастер первого запуска (открывает стол, пока не пройден) -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:theme="@style/VanksLock"
            android:launchMode="singleTask"
            android:taskAffinity="os.vanks.launcher.setup"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="locale|layoutDirection|orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale" />
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_name"
            android:icon="@mipmap/ic_settings"
            android:roundIcon="@mipmap/ic_settings"
            android:taskAffinity="os.vanks.launcher.settings"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GamesActivity"
            android:exported="true"
            android:label="@string/games_name"
            android:icon="@mipmap/ic_games"
            android:roundIcon="@mipmap/ic_games"
            android:taskAffinity="os.vanks.launcher.games"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- камера Vanks: своё место в «Недавних» и свой значок. Только в Vanks OS
             (включает CameraActivity.sync): на обычных телефонах — камера телефона.
             Свой процесс: память камеры уходит вместе с ней, стол не тяжелеет -->
        <activity
            android:name=".CameraActivity"
            android:enabled="false"
            android:process=":camera"
            android:exported="true"
            android:label="@string/camera_name"
            android:icon="@mipmap/ic_camera"
            android:roundIcon="@mipmap/ic_camera"
            android:taskAffinity="os.vanks.launcher.camera"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".RecentsActivity"
            android:exported="false"
            android:theme="@style/VanksClear"
            android:taskAffinity="os.vanks.launcher.recents"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale" />
        <receiver
            android:name=".Updater$Receiver"
            android:exported="false" />
        <!-- «Добавить на главный экран» в Winlator, GameHub и других: ярлык принимает Vanks -->
        <activity
            android:name=".PinActivity"
            android:exported="true"
            android:theme="@style/VanksClear"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
        <service
            android:name=".EdgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Боковая панель приложений у края экрана, поверх других приложений" />
        </service>
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:theme="@style/VanksLock"
            android:launchMode="singleInstance"
            android:taskAffinity="os.vanks.launcher.lock"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:showWhenLocked="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale" />
        <activity
            android:name=".AodActivity"
            android:exported="false"
            android:theme="@style/VanksAod"
            android:launchMode="singleInstance"
            android:taskAffinity="os.vanks.launcher.aod"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale" />
        <service
            android:name=".LockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Свой экран блокировки: открывается поверх всего, когда гаснет экран" />
        </service>
        <service
            android:name=".VanksAccess"
            android:exported="true"
            android:label="@string/access_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/vanks_access" />
        </service>
        <service
            android:name=".VanksNotes"
            android:exported="true"
            android:label="@string/notes_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".LockService$Boot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- снимок экрана для поиска по нему (Google Lens): только по выданному разрешению -->
        <provider
            android:name=".ShotProvider"
            android:authorities="os.vanks.launcher.shot"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
