<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="os.vanks.launcher"
    android:versionCode="22"
    android:versionName="0.22">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- пункт управления: Wi‑Fi/Bluetooth (только узнать, включены ли), «Не беспокоить»,
         яркость и автоповорот (Android попросит разрешение отдельно) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- обновление по воздуху: релизы на GitHub и установка новой версии -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- «Недавние»: закрыть приложение карточкой вверх -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- боковая панель поверх приложений: окно поверх, служба с уведомлением -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- свой экран блокировки: палец без системного окна, снова после перезагрузки -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- те же обои и в системе -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- жесты вместо кнопок на HyperOS: выдаётся только с компьютера (adb shell pm grant) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- видеть все приложения, у которых есть значок -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- паки значков (ADW / Nova / GO) -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" /></intent>
        <!-- «Найти паки значков» -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Vanks"
        android:allowBackup="true"
        android:largeHeap="true"
        android:supportsRtl="false">
        <activity
            android:name=".Home"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_name"
            android:icon="@mipmap/ic_settings"
            android:roundIcon="@mipmap/ic_settings"
            android:taskAffinity="os.vanks.launcher.settings"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GamesActivity"
            android:exported="true"
            android:label="@string/games_name"
            android:icon="@mipmap/ic_games"
            android:roundIcon="@mipmap/ic_games"
            android:taskAffinity="os.vanks.launcher.games"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".RecentsActivity"
            android:exported="false"
            android:theme="@style/VanksClear"
            android:taskAffinity="os.vanks.launcher.recents"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale" />
        <receiver
            android:name=".Updater$Receiver"
            android:exported="false" />
        <!-- «Добавить на главный экран» в Winlator, GameHub и других: ярлык принимает Vanks -->
        <activity
            android:name=".PinActivity"
            android:exported="true"
            android:theme="@style/VanksClear"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>
        <service
            android:name=".EdgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Боковая панель приложений у края экрана, поверх других приложений" />
        </service>
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:theme="@style/VanksLock"
            android:launchMode="singleInstance"
            android:taskAffinity="os.vanks.launcher.lock"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:showWhenLocked="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize|fontScale" />
        <service
            android:name=".LockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Свой экран блокировки: открывается поверх всего, когда гаснет экран" />
        </service>
        <service
            android:name=".VanksAccess"
            android:exported="true"
            android:label="@string/access_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/vanks_access" />
        </service>
        <service
            android:name=".VanksNotes"
            android:exported="true"
            android:label="@string/notes_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name=".LockService$Boot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
